{
  "name": "wsx",
  "version": "1.0.0",
  "description": "简洁的命令行笔记工具",
  "main": "cli.js",
  "bin": {
    "wsx": "./cli.js"
  },
  "scripts": {
    "start": "node cli.js",
    "server": "node server.js",
    "dev": "node dev.js",
    "dev:backend": "node server.js",
    "dev:frontend": "cd frontend && npm run dev",
    "build:frontend": "cd frontend && npm install && npm run build",
    "docker:build": "docker-compose build",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down"
  },
  "keywords": ["note", "cli", "markdown", "wsx"],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "concurrently": "^8.2.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Geoff-WSX/wsx"
  },
  "engines": {
    "node": ">=16.0.0"
  }
}
